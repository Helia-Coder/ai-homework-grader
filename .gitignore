node_modules/
.next/
out/
build/
*.tsbuildinfo
.vercel

# ---------- Python ----------
.venv/
venv/
__pycache__/
*.pyc

# ---------- 数据与日志 ----------
.data/
*.log
*.sqlite
*.db

