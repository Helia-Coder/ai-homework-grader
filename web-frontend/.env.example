# 环境变量模板 —— 复制为 .env.local 后填入真实值
# ⚠️ .env.local 和 prisma/.env 都已被 .gitignore 忽略，任何真实密钥都不得提交到仓库

# 【重要】本项目有两处数据库配置，库名必须一致，否则应用连不上表：
#   1) web-frontend/.env.local   → Next.js 应用运行时读取
#   2) web-frontend/prisma/.env  → Prisma CLI（db push / migrate）读取
# 两处都写 DATABASE_URL，库名统一为 ai_grader_db（不要写成 ai_homework_grader）。

# ---------- 必填 ----------
# 阿里云百炼 DashScope API Key（多模态模型调用）
DASHSCOPE_API_KEY=sk-your_api_key_here

# Prisma MySQL 连接串（含账号密码，务必保密）
# 库名固定为 ai_grader_db；账号密码向项目负责人索取，不要写进仓库
DATABASE_URL="mysql://user:password@host:3306/ai_grader_db"

# 登录 JWT 签名密钥，生产环境必须显式配置，建议 32 位以上随机字符串
JWT_SECRET=replace_with_a_random_secret_at_least_32_chars

# ---------- 可选（不填则使用代码内默认值）----------
# OpenAI 兼容端点
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 识别 / 批改模型与深度讲评模型（换模型无需改代码）
DASHSCOPE_GRADE_MODEL=qwen3.7-plus
DASHSCOPE_EVALUATE_MODEL=qwen3.7-plus
# 上游超时（毫秒），多模态识别较慢，默认 300000
DASHSCOPE_TIMEOUT_MS=300000
